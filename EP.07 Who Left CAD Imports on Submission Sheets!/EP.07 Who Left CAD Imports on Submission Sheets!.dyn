    {
      "ConcreteType": "Dynamo.Graph.Nodes.CustomNodes.Function, DynamoCore",
      "FunctionSignature": "8a176012-6eba-46df-8f41-6a40b2bb13a5",
      "FunctionType": "Graph",
      "NodeType": "FunctionNode",
      "Id": "8292d860e46c486798509a46e8688a1a",
      "Inputs": [
        {
          "Id": "1f91297ea1be47a387756b1133eada3a",
          "Name": "data",
          "Description": "Data to pass through\n\nvar[]..[]",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "83a10183b1e643509e0f0c59b12f0bfb",
          "Name": "waitFor",
          "Description": "Data to wait for until\nthe upper stream can be\npassed.\n\nvar[]..[]",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "55fe511a4e134238aff6c8cb7eee26a1",
          "Name": "data",
          "Description": "Passed through data",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Auto",
      "Description": "Tells the first input to wait for the second input to arrive, then passes on the first input. Really useful for scripts which have branching paths that rely on their outputs to carry each other forward.\r\n\r\nQuite a few custom packages have a 'passthrough' or 'waitfor' node. I use these all the time, so find it useful to have them contained in this package also."
    },
    {
      "ConcreteType": "Dynamo.Graph.Nodes.CustomNodes.Function, DynamoCore",
      "FunctionSignature": "c12295c8-d8aa-4a21-878c-e212cdb7c66c",
      "FunctionType": "Graph",
      "NodeType": "FunctionNode",
      "Id": "fe0fddbaa577430d82b182450f397f95",
      "Inputs": [
        {
          "Id": "0d20ba555f64472bb09739c8e1c60c84",
          "Name": "directoryPath",
          "Description": "string",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "3ee0149db1df4af6a4364d01a97fb1c7",
          "Name": "wasOpened",
          "Description": "return value",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Auto",
      "Description": "Attempts to open a directory path."
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "NodeType": "PythonScriptNode",
      "Code": "import clr\r\n\r\n# Import Revit API\r\nclr.AddReference('RevitAPI')\r\nfrom Autodesk.Revit.DB import *\r\n\r\n# Import Revit UI API\r\nclr.AddReference('RevitAPIUI')\r\nfrom Autodesk.Revit.UI import *\r\n\r\n# Import DocumentManager and TransactionManager\r\nclr.AddReference('RevitServices')\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\n# Get the current UI Document\r\nuidoc = DocumentManager.Instance.CurrentUIApplication.ActiveUIDocument\r\n\r\n# Handle inputs (ensure it behaves correctly whether fed a single item or a list)\r\nsheets_in = IN[0] if isinstance(IN[0], list) else [IN[0]]\r\n\r\n# Unwrap Dynamo elements into native Revit API objects\r\nsheets = [UnwrapElement(s) for s in sheets_in]\r\n\r\n# =========================================================================\r\n# CRITICAL STEP: \r\n# Revit API does not allow changing the active view while a transaction \r\n# is open. Dynamo often leaves transactions open, so we must force close it.\r\n# =========================================================================\r\nTransactionManager.Instance.ForceCloseTransaction()\r\n\r\nopened_sheets = []\r\nfailed = []\r\n\r\nfor sheet in sheets:\r\n    # Ensure the element is valid and is a View (ViewSheet inherits from View)\r\n    if sheet and isinstance(sheet, View):\r\n        try:\r\n            # Setting ActiveView synchronously forces Revit to open a new tab\r\n            uidoc.ActiveView = sheet\r\n            opened_sheets.append(sheet.Name)\r\n        except Exception as e:\r\n            try:\r\n                # Fallback to an asynchronous request if the UI is busy\r\n                uidoc.RequestViewChange(sheet)\r\n                opened_sheets.append(sheet.Name)\r\n            except Exception as ex:\r\n                failed.append(f\"{sheet.Name} (Error: {ex})\")\r\n    else:\r\n        if sheet:\r\n            failed.append(f\"Element is not a View or Sheet. Type: {type(sheet)}\")\r\n\r\n# Format the Output for the Dynamo Node\r\nif failed:\r\n    OUT = f\"Opened {len(opened_sheets)} sheets.\\nErrors:\\n\" + \"\\n\".join(failed)\r\nelse:\r\n    OUT = f\"Successfully opened {len(opened_sheets)} sheets:\\n\" + \"\\n\".join(opened_sheets)",
      "Engine": "CPython3",
      "EngineName": "CPython3",
      "VariableInputPorts": true,
      "Id": "8fe30f0746934bbca43dbcb38cdbc630",
      "Inputs": [
        {
          "Id": "da1891f03f45478794d3e905a3d7b9da",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "5bf6d4c63ef6439aac6d0a892e6c1094",
          "Name": "OUT",
          "Description": "Result of the python script",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Runs an embedded Python script."
    }
  ],
